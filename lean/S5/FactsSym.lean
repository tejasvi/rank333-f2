def x3 (f : Nat → Bool) : Bool := xor (xor (f 0) (f 1)) (f 2)
/-- product of 3x3 matrices in the 9-bit encoding of `toM3` -/
def mul3 (u v : Nat) : Nat := mkB (fun p => x3 (fun l => u.testBit (3 * (p / 3) + l) && v.testBit (3 * l + p % 3))) 9

