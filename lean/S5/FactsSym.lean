def allL (l : List (Nat × Nat)) (f : Nat × Nat → Bool) : Bool :=
  @List.rec (Nat × Nat) (fun _ => Bool) true (fun p _ ih => f p && ih) l
def anyL (l : List (Nat × Nat)) (f : Nat × Nat → Bool) : Bool :=
  @List.rec (Nat × Nat) (fun _ => Bool) false (fun p _ ih => f p || ih) l

