/-! # The point lemma `ClassLB 492 21`, root-level form (generated by `hpt/py/mkclsr_p.py`)

The E1P point IP `ptc` (`E = K_492 = {0, e}`, `R = 20`, 255 labels), its per-IP facts `E1P.OK_ptc.ipok` and `hrow`, the root
level `E1P.Rptc` (the top chain glued to 2352 jobs), `HPt.e1_sound_enum`, and the IP table's capacity table
`HC.T_ptc.hcls` (no row uses class 492).  Open: `RRAll`, the class certificates of `HC.T_ptc.RL`, and the jobs' coverage `hjobs`. -/
namespace HPt.C492
open E1PS RT HC E1P.IP_ptc E1P.OK_ptc

/-- **E1 on the point IP** from the jobs' coverage -/
theorem e1 (hrr : RRAll) (hcert : ∀ p ∈ T_ptc.RL, ClassLB p.1 p.2) (hjobs : ∀ k < 2352, JobOK C (E1P.slc E1P.SL_ptc.chunk) UB (E1P.Rptc_HT.entry k)) : E1Concl Em R :=
  e1_sound_enum C Em LB LBR UB UBR Ntab nrows sl tab ge ipok (hrow (T_ptc.hcls hrr hcert)) (E1P.Rptc.root hjobs)

theorem lbK : cLB K3eD_Cls.CL 492 = 21 := by decide +kernel
theorem one : oneOK Em 2 = true := by decide +kernel
theorem sub : subMask (KC 492) Em = true := by decide +kernel

theorem Em_eq : Em = kM K3eD_Cls.CL 492 := by decide +kernel
theorem e1K (hrr : RRAll) (hcert : ∀ p ∈ T_ptc.RL, ClassLB p.1 p.2) (hjobs : ∀ k < 2352, JobOK C (E1P.slc E1P.SL_ptc.chunk) UB (E1P.Rptc_HT.entry k)) :
    E1Concl (kM K3eD_Cls.CL 492) (cLB K3eD_Cls.CL 492 - 1) := by
  have h := e1 hrr hcert hjobs
  rw [Em_eq] at h
  rw [lbK]; exact h

/-- **the point lemma** from the jobs' coverage -/
theorem classLB (hrr : RRAll) (hcert : ∀ p ∈ T_ptc.RL, ClassLB p.1 p.2) (hjobs : ∀ k < 2352, JobOK C (E1P.slc E1P.SL_ptc.chunk) UB (E1P.Rptc_HT.entry k)) : ClassLB 492 21 :=
  classLB_of_e1 (by decide) (e1 hrr hcert hjobs) one sub

/-- the IP table's raised pairs are K3eD raised pairs other than 492 -/
theorem RL_sub : ∀ p ∈ T_ptc.RL, p ∈ T_K3eD_Cls.RL ∧ p.1 ≠ 492 := by decide +kernel

/-- **the point lemma**, in the form of top/GAPS.md G1/G2: `RRAll`, the K3eD class certificates away from 492, the jobs -/
theorem classLB_K (hrr : RRAll) (hCap : ∀ p ∈ T_K3eD_Cls.RL, p.1 ≠ 492 → ClassLB p.1 p.2) (hjobs : ∀ k < 2352, JobOK C (E1P.slc E1P.SL_ptc.chunk) UB (E1P.Rptc_HT.entry k)) : ClassLB 492 21 :=
  classLB hrr (fun p hp => hCap p (RL_sub p hp).1 (RL_sub p hp).2) hjobs

