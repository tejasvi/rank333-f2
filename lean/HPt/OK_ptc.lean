theorem sl_zero : ∀ i, Ntab ≤ i → i < 2 ^ 19 → sl i = 0 := by
  intro i h1 h2
  unfold Ntab at h1
  have h := slZ_spec 417198 107090 zAll (i - 417198) (by omega)
  rwa [show 417198 + (i - 417198) = i by omega] at h
theorem ipok : IPOK C Em LB LBR UB UBR Ntab nrows sl tab ge where
  N_le := N_le
  R_le := R_le
  R_pos := R_pos
  DOM_lt := DOM_lt
  cosets := cosets
  domperp := domperp
  planes := planes
  planesR := planesR
  sl_spec := fun i hi => ⟨(sl_all i hi).1, (sl_all i hi).2.1⟩
  sl_zero := sl_zero
  Ntab_le := Ntab_le
  UB_eq := UB_eq
  UBR_eq := UBR_eq
  UB_le := UB_le
  capslot := capslot
  grp := grp
/-- every slot's row fact, from the IP's class table (`entry_sound`), or trivial (`R ≤ cap`) -/
theorem hrow (hcls : ∀ c, RT.Fact (RT.kM RT.Cls_ptc.CL c) (RT.cLB RT.Cls_ptc.CL c)) :
    ∀ i < Ntab, RT.Fact (RT.dualM (tab i)) (C.R - RT.eCap (tab i)) := by
  intro i hi
  rcases (sl_all i hi).2.2 with h | h
  · exact RT.entry_sound 20 RT.Cls_ptc.CL (tab i) (hcls _) h
  · have h0 : C.R - RT.eCap (tab i) = 0 := Nat.sub_eq_zero_of_le h
    rw [h0]; intro n av b c _ _; exact Nat.zero_le _
end E1P.OK_ptc
