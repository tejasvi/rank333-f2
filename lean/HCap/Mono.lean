| 448 | 19 | 321 | - |
| 479 | 20 | 420 | - |
-/
namespace HCap
open HC RT

/-- the E1 statement from a class bound: `Fact m lb` excludes exactly `lb - 1` outside terms -/
theorem e1Concl_of_fact {m lb : Nat} (hlb : 1 ≤ lb) (h : Fact m lb) : E1Concl m (lb - 1) := by
  intro n av b c hav hd hbc hR
  have := h n av b c hav hd
  omega

/-- transport of a class bound to a class whose subspace a symmetry maps into the first one's -/
theorem mono {c u lb : Nat} {t : Bool} {P Q : Nat} (hP : C3.isGL P = true) (hQ : C3.isGL Q = true)
    (hmap : mapsTo t P Q (KC u) (KC c) = true) (h : ClassLB u lb) : ClassLB c lb :=
  fact_transport' hP hQ hmap h

namespace Mono

/-- class 298 at 17 from class 185 (`(t, P, Q) = (false, 305, 273)`) -/
theorem c298 (h : ClassLB 185 17) : ClassLB 298 17 :=
  mono (t := false) (P := 305) (Q := 273) (by decide +kernel) (by decide +kernel) (by decide +kernel) h
theorem lb298 : cLB K3eD_Cls.CL 298 = 17 := by decide +kernel
/-- the E1 statement of class 298 for `HC.hcls_K3eD_final` -/
theorem e298 (h : ClassLB 185 17) : E1Concl (kM K3eD_Cls.CL 298) (cLB K3eD_Cls.CL 298 - 1) := by
  rw [lb298]; exact e1Concl_of_fact (by decide) (c298 h)

