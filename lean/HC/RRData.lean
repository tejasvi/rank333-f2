@[expose] public section
namespace HC
open FullTable

/-- RR's lower bound per element (FullTable_03_Theorems) -/
def RRB : List Nat := [0, 3, 6, 9, 6, 9, 6, 9, 9, 9, 12, 12, 9, 12, 12, 9, 12, 14, 9, 9, 12, 9, 9, 12, 12, 12, 9, 12, 13, 15, 12, 15, 12, 15, 14, 15, 14, 12, 12, 12, 12, 12, 9, 12, 12, 15, 12, 15, 12, 12, 14, 14, 12, 12, 12, 14, 14, 15, 12, 12, 12, 12, 14, 15, 16, 15, 12, 15, 15, 15, 14, 14, 15, 12, 14, 16, 15, 15, 14, 15, 15, 15, 15, 15, 15, 18, 12, 11, 14, 12, 12, 14, 14, 15, 12, 15, 17, 17, 15, 15, 15, 15, 12, 15, 12, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 12, 15, 15, 15, 14, 15, 14, 17, 17, 15, 17, 15, 17, 15, 15, 15, 14, 17, 15, 15, 12, 15, 15, 12, 15, 14, 15, 15, 14, 15, 16, 17, 17, 15, 15, 16, 15, 16, 15, 15, 15, 16, 15, 15, 17, 17, 17, 17, 15, 17, 15, 17, 15, 15, 15, 15, 15, 16, 17, 15, 17, 15, 15, 17, 15, 16, 17, 16, 15, 17, 16, 15, 15, 16, 15, 15, 14, 15, 15, 17, 16, 17, 15, 15, 15, 16, 16, 17, 17, 17, 17, 16, 17, 17, 16, 17, 17, 17, 17, 17, 15, 17, 17, 17, 12, 15, 16, 15, 15, 15, 17, 15, 15, 15, 17, 17, 15, 16, 15, 16, 17, 17, 17, 17, 17, 17, 17, 17, 18, 17, 16, 17, 18, 14, 14, 15, 17, 15, 17, 17, 17, 15, 15, 15, 16, 17, 17, 17, 17, 16, 17, 15, 16, 14, 17, 15, 15, 17, 17, 17, 17, 17, 17, 17, 17, 17, 16, 17, 17, 18, 18, 17, 18, 17, 18, 18, 17, 16, 17, 17, 17, 17, 17, 16, 17, 17, 18, 18, 18, 17, 18, 18, 18, 17, 18, 18, 17, 18, 17, 18, 17, 18, 16, 17, 17, 18, 18, 18, 15, 16, 15, 15, 15, 17, 17, 17, 15, 17, 17, 17, 17, 16, 17, 16, 17, 17, 17, 17, 17, 17, 15, 17, 17, 17, 15, 17, 17, 18, 18, 18, 17, 17, 18, 18, 18, 17, 17, 18, 17, 17, 17, 18, 18, 18, 17, 17, 17, 18, 18, 17, 17, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 17, 18, 18, 18, 18, 18, 18, 18, 17, 18, 18, 18, 17, 18, 17, 18, 18, 18, 17, 15, 17, 18, 17, 17, 18, 17, 18, 18, 18, 19, 18, 18, 18, 18, 18, 18, 17, 17, 18, 18, 18, 17, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 19, 19, 18, 19, 19, 19, 19, 19, 19, 18, 19, 19, 18, 19, 19, 19, 18, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 18, 19, 19, 19, 19, 19, 20, 20, 20, 20, 20, 20, 20, 20, 20, 21, 21, 22]

def rrLB (c : Nat) : Nat := RRB.getD c 0

/-- every element's claim, as one proposition -/
def RRAll : Prop := ∀ c < 496, TableAtLeast (conditions_of_element c) (rrLB c)

/-- a list of `(element, bound)` claims -/
def AllAL : List (Nat × Nat) → Prop
  | [] => True
  | p :: rest => TableAtLeast (conditions_of_element p.1) p.2 ∧ AllAL rest

theorem AllAL_mem : ∀ (l : List (Nat × Nat)), AllAL l → ∀ p ∈ l, TableAtLeast (conditions_of_element p.1) p.2
  | [], _, p, hp => absurd hp (List.not_mem_nil)
  | q :: rest, h, p, hp => by
    rcases List.mem_cons.mp hp with e | e
    · rw [e]; exact h.1
    · exact AllAL_mem rest h.2 p e

theorem AllAL_append {l1 l2 : List (Nat × Nat)} (h1 : AllAL l1) (h2 : AllAL l2) : AllAL (l1 ++ l2) := by
  induction l1 with
  | nil => exact h2
  | cons q rest ih => exact ⟨h1.1, ih h1.2⟩

/-- `RRAll` from claims covering every element with its bound -/
def coversN (l : List (Nat × Nat)) (n : Nat) : Bool :=
  Nat.rec (motive := fun _ => Bool) true (fun c b => b && l.contains (c, rrLB c)) n

def coversB (l : List (Nat × Nat)) : Bool := coversN l 496

theorem coversB_rec (l : List (Nat × Nat)) (n : Nat) (h : coversN l n = true) : ∀ c < n, (c, rrLB c) ∈ l := by
  unfold coversN at h
  induction n with
  | zero => intro c hc; exact absurd hc (Nat.not_lt_zero c)
  | succ n ih =>
    have h' : (Nat.rec (motive := fun _ => Bool) true (fun c b => b && l.contains (c, rrLB c)) n &&
        l.contains (n, rrLB n)) = true := h
    rw [Bool.and_eq_true] at h'
    intro c hc
    rcases Nat.lt_succ_iff_lt_or_eq.mp hc with hlt | heq
    · exact ih h'.1 c hlt
    · subst heq; exact List.contains_iff_mem.mp h'.2

theorem rrAll_of (l : List (Nat × Nat)) (hl : AllAL l) (hc : coversB l = true) : RRAll := by
  intro c hcl
  exact AllAL_mem l hl (c, rrLB c) (coversB_rec l 496 hc c hcl)

end HC
