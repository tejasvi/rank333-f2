/-! # The capacity tables of all class tables, from one list of class certificates (generated by `hcls/gen_ipasm.py`)

`CERTS`: one `(class, bound)` per raised class over the tables `RT.Cls_e150`, `RT.Cls_e490x`, `RT.K3eD_Cls`, with the largest bound any of them needs.
The fleet proves `ClassLB c lb` once per pair (`classLB_of_e1`: an E1 run on the IP of `c`); a table needing a lower
bound gets it by monotonicity (`covers`). -/
@[expose] public section
namespace HC
open RT

/-- the class certificates all tables need (123) -/
def CERTS : List (Nat × Nat) := [(150, 17), (159, 18), (185, 17), (202, 18), (203, 18), (204, 18), (205, 18), (206, 17), (207, 18), (210, 18), (212, 18), (213, 18), (218, 18), (232, 17), (234, 17), (236, 18), (237, 18), (239, 18), (240, 18), (241, 18), (242, 18), (244, 18), (245, 18), (246, 18), (267, 17), (279, 18), (281, 17), (284, 19), (291, 18), (292, 17), (295, 18), (297, 18), (298, 17), (300, 18), (303, 19), (304, 18), (311, 18), (313, 18), (317, 17), (318, 18), (321, 19), (324, 17), (334, 18), (335, 18), (336, 17), (338, 17), (339, 18), (343, 18), (355, 18), (356, 18), (361, 18), (363, 18), (364, 18), (365, 18), (369, 18), (370, 18), (371, 18), (374, 18), (375, 18), (378, 19), (379, 19), (382, 19), (384, 19), (386, 19), (387, 19), (390, 19), (391, 18), (392, 19), (394, 19), (395, 19), (399, 18), (400, 19), (401, 19), (402, 19), (403, 18), (404, 19), (405, 18), (406, 19), (407, 19), (408, 19), (409, 19), (418, 19), (420, 20), (421, 19), (422, 19), (423, 19), (425, 19), (426, 19), (435, 19), (436, 19), (438, 19), (439, 19), (441, 19), (443, 19), (444, 19), (445, 19), (446, 19), (447, 19), (448, 19), (450, 20), (451, 20), (454, 20), (455, 20), (456, 20), (458, 20), (460, 20), (463, 20), (464, 20), (465, 20), (468, 20), (469, 20), (470, 20), (471, 20), (472, 20), (473, 20), (474, 20), (475, 20), (476, 20), (479, 20), (485, 21), (487, 21), (490, 21), (492, 21)]

/-- every pair of `RL` is implied by a pair of `CERTS` -/
def coveredB (RL : List (Nat × Nat)) : Bool := RL.all fun p => CERTS.any fun q => q.1 == p.1 && Nat.ble p.2 q.2

theorem covered {RL : List (Nat × Nat)} (h : coveredB RL = true) (hcert : ∀ q ∈ CERTS, ClassLB q.1 q.2) :
    ∀ p ∈ RL, ClassLB p.1 p.2 := by
  intro p hp
  obtain ⟨q, hq, hq2⟩ := List.any_eq_true.mp (List.all_eq_true.mp h p hp)
  simp only [Bool.and_eq_true, beq_iff_eq, Nat.ble_eq] at hq2
  have hc := hcert q hq
  rw [hq2.1] at hc
  exact fact_mono hq2.2 (fun _ _ h => h) hc

theorem cov_Cls_e150 : coveredB T_Cls_e150.RL = true := by decide +kernel
theorem cov_Cls_e490x : coveredB T_Cls_e490x.RL = true := by decide +kernel
theorem cov_K3eD_Cls : coveredB T_K3eD_Cls.RL = true := by decide +kernel

/-- **the capacity table of `RT.Cls_e150`**, from the certificates of its own raised pairs (no circularity: an IP
table's raised classes are superspace classes of its `E`) -/
theorem hcls_Cls_e150_final (hcert : ∀ p ∈ T_Cls_e150.RL, ClassLB p.1 p.2) :
    ∀ c, Fact (kM RT.Cls_e150.CL c) (cLB RT.Cls_e150.CL c) :=
  T_Cls_e150.hcls rr_all hcert

/-- the same from the global certificate list -/
theorem hcls_Cls_e150_of_certs (hcert : ∀ p ∈ CERTS, ClassLB p.1 p.2) :
    ∀ c, Fact (kM RT.Cls_e150.CL c) (cLB RT.Cls_e150.CL c) :=
  T_Cls_e150.hcls rr_all (covered cov_Cls_e150 hcert)

/-- **the capacity table of `RT.Cls_e490x`**, from the certificates of its own raised pairs (no circularity: an IP
table's raised classes are superspace classes of its `E`) -/
theorem hcls_Cls_e490x_final (hcert : ∀ p ∈ T_Cls_e490x.RL, ClassLB p.1 p.2) :
    ∀ c, Fact (kM RT.Cls_e490x.CL c) (cLB RT.Cls_e490x.CL c) :=
  T_Cls_e490x.hcls rr_all hcert

/-- the same from the global certificate list -/
theorem hcls_Cls_e490x_of_certs (hcert : ∀ p ∈ CERTS, ClassLB p.1 p.2) :
    ∀ c, Fact (kM RT.Cls_e490x.CL c) (cLB RT.Cls_e490x.CL c) :=
  T_Cls_e490x.hcls rr_all (covered cov_Cls_e490x hcert)

/-- **the capacity table of `RT.K3eD_Cls`**, from the certificates of its own raised pairs (no circularity: an IP
table's raised classes are superspace classes of its `E`) -/
theorem hcls_K3eD_Cls_final (hcert : ∀ p ∈ T_K3eD_Cls.RL, ClassLB p.1 p.2) :
    ∀ c < 496, Fact (kM RT.K3eD_Cls.CL c) (cLB RT.K3eD_Cls.CL c) :=
  T_K3eD_Cls.hcls rr_all hcert

/-- the same from the global certificate list -/
theorem hcls_K3eD_Cls_of_certs (hcert : ∀ p ∈ CERTS, ClassLB p.1 p.2) :
    ∀ c < 496, Fact (kM RT.K3eD_Cls.CL c) (cLB RT.K3eD_Cls.CL c) :=
  T_K3eD_Cls.hcls rr_all (covered cov_K3eD_Cls hcert)

/-- **the main search's capacity table, distinct-factor form**: class 492 free (`factN_492`), the other 110
raised pairs of `K3eD` certified -/
theorem hclsN_K3eD_Cls_final (hcert : ∀ p ∈ T_K3eD_Cls.RL, p.1 ≠ 492 → ClassLB p.1 p.2) :
    ∀ c < 496, FactN 22 (kM K3eD_Cls.CL c) (cLB K3eD_Cls.CL c) := by
  intro c hc
  by_cases h : c = 492
  · subst h; exact factN_492
  · refine fact_factN 22 (class_fact _ subZ_K3eD rr_all c hc (fun hlt => Or.inl ?_))
    have hm := pairs_rec _ _ 496 T_K3eD_Cls.pairs c hc hlt
    have hk := kc_rec K3eD_Cls.CL 496 T_K3eD_Cls.kc c hc
    unfold kcOK at hk
    have hm2 : subMask (kM K3eD_Cls.CL c) (KC c) = true := by
      have : cLB K3eD_Cls.CL c ≠ 0 := by omega
      simpa [this] using hk
    exact fact_mono le_rfl (subMask_spec hm2) (hcert _ hm h)

end HC

