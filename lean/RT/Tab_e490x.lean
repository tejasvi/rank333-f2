theorem allOK_spec (a m : Nat) (h : allOK a m = true) : ∀ i < m, entryOK R Cls_e490x.CL (entry (a + i)) = true := by
  induction m with
  | zero => intro i hi; exact absurd hi (Nat.not_lt_zero i)
  | succ m ih =>
    intro i hi
    have h' : (allOK a m && entryOK R Cls_e490x.CL (entry (a + m))) = true := h
    rw [Bool.and_eq_true] at h'
    rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hlt | heq
    · exact ih h'.1 i hlt
    · rw [heq]; exact h'.2

