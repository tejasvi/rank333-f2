/-! # Soundness of BranchCheck v7L (SAT leaves for the L479 lift test)

`leafSL_sound`: an accepted leaf record (`BC7L.leafSL lt R`, the v6 record format) with a sound leaf test `lt`
(`LiftTest lt`) gives `L479.NoLift3 (leafT R) (leafN R) (leafDom6 R)`.

The node induction is S7's (`S7.checkS7_sound`) with two more facts carried for the decomposition `(b, c)`:
* `AsgOK`: the path's assignment `asg` is `(a_t, b_t, c_t)` over the assigned terms `t`, each once;
* the two lifts `L479.Lift n b c Y1` and `L479.Lift n b c Y2`.
At a `br` node the child's decomposition is the parent's, or (at a `sym` root) its image under two GL3 moves
(`sym_transform7M`: `S7.sym_transform7` with the moves made explicit), which keeps both lifts (`S7L.lift_move`).  At a SAT
leaf every term is assigned, so `asg` is the decomposition itself and its lifts are sublist lifts (`liftL_of_complete`),
which the test excludes.

This file is generated by `sat/mksatcheck.py` from `S7/Check7.lean` (`br_step7_ex` is `br_step7` returning the child). -/
@[expose] public section
namespace S7L
open BC4 BC5 BC6 BC6s BC7s S5 S6 S7 RootSound Matrix BC7T

/-- `Y` lifts for the decomposition listed in `asg`: `T(Y)` plus the matrices `b cᵀ` of a sublist is a nonzero rank-1
matrix -/
def LiftL (asg : Asg) (Y : Nat) : Prop :=
  ∃ l : Asg, l.Sublist asg ∧ ∃ u v : Fin 9 → F2, u ≠ 0 ∧ v ≠ 0 ∧
    TX (toM3 Y) + (l.map (fun e => vecMulVec (nv e.2.1) (nv e.2.2))).sum = vecMulVec u v

/-- **the leaf test's contract**: whenever `lt asg w` holds, at most one of `X0, X1, X0 ^^^ X1` lifts for `asg` -/
def LiftTest (lt : Asg → Nat → Bool) : Prop :=
  ∀ asg w, lt asg w = true →
    ¬ (LiftL asg L479.X0 ∧ LiftL asg L479.X1) ∧ ¬ (LiftL asg L479.X0 ∧ LiftL asg (L479.X0 ^^^ L479.X1)) ∧
      ¬ (LiftL asg L479.X1 ∧ LiftL asg (L479.X0 ^^^ L479.X1))

/-- the path's assignment lists `(a_t, b_t, c_t)` for exactly the assigned terms (`t < n`, not active), each once -/
def AsgOK (T n : Nat) (b c : Nat → Nat) (ACT : Nat) (asg : Asg) : Prop :=
  ∃ ts : List Nat, ts.Nodup ∧ (∀ t, t ∈ ts ↔ (t < n ∧ ACT.testBit t = false)) ∧
    asg = ts.map (fun t => (aT T t, b t, c t))

/-- the decomposition after a `br` step: unchanged, or (at the root) moved by two GL3 moves -/
def Move (asg : Asg) (b c b' c' : Nat → Nat) : Prop :=
  (b' = b ∧ c' = c) ∨ (asg = [] ∧ ∃ p q : Nat × Nat, mul3 p.1 p.2 = 273 ∧ mul3 q.1 q.2 = 273 ∧
    b' = (fun u => mul3 (mul3 (b u) p.1) q.1) ∧ c' = (fun u => mul3 q.2 (mul3 p.2 (c u))))

theorem lift_of_move {asg : Asg} {n : Nat} {b c b' c' : Nat → Nat} {Y : Nat} (hm : Move asg b c b' c')
    (h : L479.Lift n b c Y) : L479.Lift n b' c' Y := by
  rcases hm with ⟨rfl, rfl⟩ | ⟨_, p, q, hp, hq, rfl, rfl⟩
  · exact h
  · exact lift_move n _ _ Y q hq (lift_move n b c Y p hp h)

theorem asgOK_root (T n : Nat) (b c : Nat → Nat) : AsgOK T n b c (2 ^ n - 1) [] := by
  refine ⟨[], List.nodup_nil, fun t => ⟨fun h => absurd h List.not_mem_nil, fun ⟨h1, h2⟩ => ?_⟩, rfl⟩
  rw [Nat.testBit_two_pow_sub_one, decide_eq_false_iff_not] at h2
  exact absurd h1 h2

theorem asgOK_move {T n : Nat} {b c b' c' : Nat → Nat} {ACT : Nat} {asg : Asg} (h : AsgOK T n b c ACT asg)
    (hm : Move asg b c b' c') : AsgOK T n b' c' ACT asg := by
  rcases hm with ⟨rfl, rfl⟩ | ⟨rfl, _⟩
  · exact h
  · obtain ⟨ts, hnd, hmem, he⟩ := h
    cases ts with
    | nil => exact ⟨[], hnd, hmem, rfl⟩
    | cons x xs => rw [List.map_cons] at he; exact absurd he.symm (List.cons_ne_nil _ _)

theorem asgOK_step {T n : Nat} {b c : Nat → Nat} {ACT : Nat} {asg : Asg} (h : AsgOK T n b c ACT asg) (t : Nat)
    (htn : t < n) (hact : ACT.testBit t = true) :
    AsgOK T n b c (ACT ^^^ 1 <<< t) ((aT T t, b t, c t) :: asg) := by
  obtain ⟨ts, hnd, hmem, he⟩ := h
  refine ⟨t :: ts, List.nodup_cons.mpr ⟨fun ht => ?_, hnd⟩, fun u => ?_, by rw [he]; rfl⟩
  · have h2 := ((hmem t).mp ht).2
    rw [hact] at h2; exact absurd h2 (by decide)
  · rw [List.mem_cons, hmem u, Nat.testBit_xor, Nat.one_shiftLeft, Nat.testBit_two_pow]
    by_cases e : u = t
    · subst e; simp [htn, hact]
    · have e' : ¬ (t = u) := fun x => e x.symm
      simp only [e, e', false_or, decide_false, Bool.xor_false]

/-- at a complete assignment a lift of the decomposition is a sublist lift of `asg` -/
theorem liftL_of_complete {T n : Nat} {b c : Nat → Nat} {asg : Asg} (h : AsgOK T n b c 0 asg) (Y : Nat)
    (hl : L479.Lift n b c Y) : LiftL asg Y := by
  classical
  obtain ⟨ts, hnd, hmem, he⟩ := h
  obtain ⟨S, hS, u, v, hu, hv, hsum⟩ := hl
  refine ⟨(ts.filter (fun t => decide (t ∈ S))).map (fun t => (aT T t, b t, c t)), ?_, u, v, hu, hv, ?_⟩
  · rw [he]; exact List.Sublist.map _ List.filter_sublist
  · rw [← hsum, List.map_map, ← List.sum_toFinset _ (hnd.filter _)]
    congr 1
    apply Finset.sum_congr _ (fun x _ => rfl)
    ext t
    simp only [List.mem_toFinset, List.mem_filter, decide_eq_true_eq, hmem, Nat.zero_testBit, and_true]
    exact ⟨fun h => h.2, fun ht => ⟨Finset.mem_range.mp (hS ht), ht⟩⟩

/-- **`S7.sym_transform7` with the moves explicit**: at the root, any decomposition is moved by two GL3 moves so that
`b_t ∈ ORBM` and `c_t ∈ CORB[b_t]`, with every factor's rank unchanged. -/
theorem sym_transform7M {T n dom ACT : Nat} {b c : Nat → Nat} (hbc : BC n b c) (hd : HD T n dom b c ACT []) (t : Nat)
    (ht : t < n) : ∃ b' c' : Nat → Nat, BC n b' c' ∧ HD T n dom b' c' ACT [] ∧ ORBM.testBit (b' t) = true ∧
      (corbM (b' t)).testBit (c' t) = true ∧ (∀ u, u < n → rk3 (b' u) = rk3 (b u) ∧ rk3 (c' u) = rk3 (c u)) ∧
      ∃ p q : Nat × Nat, mul3 p.1 p.2 = 273 ∧ mul3 q.1 q.2 = 273 ∧
        b' = (fun u => mul3 (mul3 (b u) p.1) q.1) ∧ c' = (fun u => mul3 q.2 (mul3 p.2 (c u))) := by
  -- the first move takes `b_t` to its orbit representative (the choice of `S6.sym_transform_rk`)
  have hv := allLT_spec orb_fact (b t) (hbc t ht).2.1
  have hb0 : (b t == 0) = false := by
    have := (hbc t ht).1; cases e : (b t == 0)
    · rfl
    · rw [beq_iff_eq] at e; omega
  rw [hb0, Bool.false_or] at hv
  obtain ⟨p, hp, hpo⟩ := anyL_spec hv
  have hinv := allL_spec g3_fact p hp
  rw [beq_iff_eq] at hinv
  obtain ⟨hbc1, hd1, hrk1⟩ := sym_move hbc hd p hinv
  obtain ⟨hb10, hb1l, hc10, hc1l⟩ : 0 < mul3 (b t) p.1 ∧ mul3 (b t) p.1 < 512 ∧ 0 < mul3 p.2 (c t) ∧
      mul3 p.2 (c t) < 512 := hbc1 t ht
  -- the second move fixes `b_t` and takes `c_t` into `CORB[b_t]`
  obtain ⟨q, hfix, hinvq, hcorb⟩ := corb_exists (mul3 (b t) p.1) (mul3 p.2 (c t)) hpo (by omega) hb1l hc1l (by omega)
  obtain ⟨hbc2, hd2, hrk2⟩ := sym_move hbc1 hd1 q hinvq
  refine ⟨_, _, hbc2, hd2, ?_, ?_, ?_, p, q, hinv, hinvq, rfl, rfl⟩
  · show ORBM.testBit (mul3 (mul3 (b t) p.1) q.1) = true
    rw [hfix]; exact hpo
  · show (corbM (mul3 (mul3 (b t) p.1) q.1)).testBit (mul3 q.2 (mul3 p.2 (c t))) = true
    rw [hfix]; exact hcorb
  · intro u hu
    obtain ⟨e1, e2⟩ := hrk2 u hu
    obtain ⟨f1, f2⟩ := hrk1 u hu
    exact ⟨e1.trans f1, e2.trans f2⟩

/-- **`br` step, the child returned.** `S7.br_step7` with the conclusion: some candidate `p = (b'_t, c'_t)` and the
child state for the (possibly moved) decomposition `(b', c')`. -/
theorem br_step7_ex (T n dom need : Nat) (hn : n ≤ 32) (SS : Nat) (hSS : SSok T n SS) (ACT : Nat) (asg : Asg)
    (recs : List Rec) (t : Nat) (sym cdir : Bool) (nt sl : List Nat) (hnt : ∀ x ∈ nt, x < 512) (hsl : ∀ x ∈ sl, x < 512)
    (h1 : bit ACT t = true) (h2 : ((!sym) || asg.isEmpty) = true) (h3 : allDom dom nt = true)
    (h4 : (mkRecs6 SS ACT asg nt []).1 = true) (h5 : allDom dom sl = true) (h6 : allThru (aT T t) sl = true)
    (h7 : (mkSls6 SS ACT asg sl).1 = true)
    (b c : Nat → Nat) (hinv : Inv T n dom b c ACT asg recs) (hlg : LGok n need b c) :
    ∃ p ∈ brCands7 SS ACT need asg recs t (aT T t) nt sl sym cdir, ∃ b' c' : Nat → Nat,
      Inv T n dom b' c' (ACT ^^^ 1 <<< t) ((aT T t, p.1, p.2) :: asg)
        (updRecs (aT T t) p.1 p.2 (brAllr7 SS ACT asg recs nt)) ∧ LGok n need b' c' ∧ p = (b' t, c' t) ∧
      Move asg b c b' c' := by
  set nr := mkRecs6 SS ACT asg nt [] with hnr
  set part := thru (aT T t) recs (thru (aT T t) nr.2 []) with hpart
  set allr := app recs nr.2 with hallr
  set ss := mkSls6 SS ACT asg sl with hss
  set lgm := lgMask need t with hlgm
  set B := andLm part (Nat.land (Nat.land ALLNZ lgm) (cond sym ORBM M512)) with hB
  set Cb := andRm part (Nat.land ALLNZ lgm) with hCb
  set cs := brCands7 SS ACT need asg recs t (aT T t) nt sl sym cdir with hcs0
  have hcs : cs = cond cdir (cond (Nat.beq Cb 0) [] (cond (Nat.beq B 0) [] (candsC part ss.2 B (bitsOf Cb))))
      (cond (Nat.beq B 0) [] (candsB7 sym part ss.2 Cb (bitsOf B))) := rfl
  have hallr' : brAllr7 SS ACT asg recs nt = allr := rfl
  rw [hallr']
  clear_value nr part allr ss lgm B Cb cs
  have hact : ACT.testBit t = true := by rw [← bit_eq]; exact h1
  have htn : t < n := hinv.act t hact
  -- the decomposition to follow (moved by GL3 at a `sym` root), with the Lemma G masks kept
  obtain ⟨b', c', hinv', hlg', horb, hcorb, hmove⟩ : ∃ b' c' : Nat → Nat, Inv T n dom b' c' ACT asg recs ∧
      LGok n need b' c' ∧ (sym = true → ORBM.testBit (b' t) = true) ∧
      (sym = true → (corbM (b' t)).testBit (c' t) = true) ∧ Move asg b c b' c' := by
    cases hs : sym
    · exact ⟨b, c, hinv, hlg, fun h => absurd h Bool.false_ne_true, fun h => absurd h Bool.false_ne_true,
        Or.inl ⟨rfl, rfl⟩⟩
    · rw [hs] at h2
      have hasg : asg = [] := by simpa using h2
      have hrecs := hinv.root hasg
      subst hasg; subst hrecs
      obtain ⟨b', c', hbc', hd', ho, hco, hrk, p, q, hp, hq, eb, ec⟩ := sym_transform7M hinv.bc hinv.hd t htn
      refine ⟨b', c', ⟨hinv.act, hbc', hinv.asg_lt, hd', fun _ => rfl, fun r hr => absurd hr List.not_mem_nil⟩,
        fun u hu => ?_, fun _ => ho, fun _ => hco, Or.inr ⟨rfl, p, q, hp, hq, eb, ec⟩⟩
      obtain ⟨_, hb, _, hc⟩ := hinv.bc u hu
      obtain ⟨_, hb', _, hc'⟩ := hbc' u hu
      obtain ⟨e1, e2⟩ := hrk u hu
      obtain ⟨l1, l2⟩ := hlg u hu
      rw [lgMask_bit _ _ _ hb] at l1
      rw [lgMask_bit _ _ _ hc] at l2
      rw [lgMask_bit _ _ _ hb', lgMask_bit _ _ _ hc', e1, e2]
      exact ⟨l1, l2⟩
  clear hinv hlg
  obtain ⟨_, hb1, _, hc1⟩ := hinv'.bc t htn
  -- records and slack data
  have hnrok : ∀ r ∈ nr.2, RecOK T n b' c' ACT r := by
    intro r hr
    rw [hnr] at hr h4
    rcases mem_mkRecs6 _ _ _ _ _ h4 r hr with h | ⟨X, hX, hok, rfl⟩
    · exact absurd h List.not_mem_nil
    · exact mkRec6_sound hn hSS hinv'.act hinv'.bc hinv'.asg_lt hinv'.hd X (hnt X hX) (allDom_spec dom nt h3 X hX) hok
  have hallok : ∀ r ∈ allr, RecOK T n b' c' ACT r := by
    intro r hr; rw [hallr] at hr
    rcases mem_app _ _ r hr with h | h
    · exact hinv'.recs r h
    · exact hnrok r h
  have hpartok : ∀ r ∈ part, RecOK T n b' c' ACT r ∧ t ∈ hitS T n ACT r.X := by
    intro r hr; rw [hpart] at hr
    have hthru : ∀ r, r ∈ recs ∨ r ∈ nr.2 → par (r.X &&& aT T t) = true →
        RecOK T n b' c' ACT r ∧ t ∈ hitS T n ACT r.X := by
      intro r hr hp
      refine ⟨?_, mem_hitS.mpr ⟨htn, hact, by rw [Nat.and_comm]; exact hp⟩⟩
      rcases hr with h | h
      · exact hinv'.recs r h
      · exact hnrok r h
    rcases mem_thru _ recs _ r hr with ⟨h, hp⟩ | h
    · exact hthru r (Or.inl h) hp
    · rcases mem_thru _ nr.2 [] r h with ⟨h', hp⟩ | h'
      · exact hthru r (Or.inr h') hp
      · exact absurd h' List.not_mem_nil
  have hssok : ∀ sd ∈ ss.2, sd.2.1.testBit (b' t) = true ∨ sd.2.2.testBit (c' t) = true := by
    intro sd hsd
    rw [hss] at hsd h7
    obtain ⟨X, hX, hok, rfl⟩ := mem_mkSls6 _ _ _ _ h7 sd hsd
    exact mkSl6_sound hn hSS hinv'.act hinv'.bc hinv'.asg_lt hinv'.hd X (hsl X hX) (allDom_spec dom sl h5 X hX) hok t
      (mem_hitS.mpr ⟨htn, hact, allThru_spec _ sl h6 X hX⟩)
  -- the true factors pass every mask
  obtain ⟨hlgb, hlgc⟩ := hlg' t htn
  have hBlt : B < 2 ^ 512 := by
    rw [hB]; exact lt_of_le_of_lt (le_trans (andLm_le _ _) (le_trans Nat.and_le_left Nat.and_le_left)) allnz_lt
  have hCblt : Cb < 2 ^ 512 := by
    rw [hCb]; exact lt_of_le_of_lt (le_trans (andRm_le _ _) Nat.and_le_left) allnz_lt
  have hBbit : B.testBit (b' t) = true := by
    rw [hB]
    refine andLm_bit part _ _ ?_ (fun r hr => ((hpartok r hr).1.2.2 t (hpartok r hr).2).1)
    show ((ALLNZ &&& lgm) &&& cond sym ORBM M512).testBit (b' t) = true
    rw [Nat.testBit_and, Nat.testBit_and, allnz_bit, hlgm, hlgb]
    have h0 : decide (0 < b' t ∧ b' t < 512) = true := decide_eq_true ⟨by omega, hb1⟩
    rw [h0, Bool.true_and, Bool.true_and]
    cases hs : sym
    · rw [cond_false, m512_eq, Nat.testBit_two_pow_sub_one]; exact decide_eq_true hb1
    · rw [cond_true]; exact horb hs
  have hCbit : Cb.testBit (c' t) = true := by
    rw [hCb]
    refine andRm_bit part _ _ ?_ (fun r hr => ((hpartok r hr).1.2.2 t (hpartok r hr).2).2)
    show (ALLNZ &&& lgm).testBit (c' t) = true
    rw [Nat.testBit_and, allnz_bit, hlgm, hlgc]
    exact Bool.and_true _ ▸ decide_eq_true ⟨by omega, hc1⟩
  have hCbit7 : (cond sym (Nat.land Cb (corbM (b' t))) Cb).testBit (c' t) = true := by
    cases hs : sym
    · rw [cond_false]; exact hCbit
    · rw [cond_true, Nat.land_eq, Nat.testBit_and, hCbit, hcorb hs]; rfl
  have hcm : (cmS (b' t) ss.2 (cmT (b' t) part (cond sym (Nat.land Cb (corbM (b' t))) Cb))).testBit (c' t) = true := by
    apply cmS_bit _ _ _ _ _ hssok
    apply cmT_bit _ _ _ _ hCbit7
    intro r hr
    rw [nperp_bit _ _ (xof_lt _ _) hc1, (hpartok r hr).1.2.1 t t (hpartok r hr).2 (hpartok r hr).2]
    simp
  have hbm : (bmS (c' t) ss.2 (bmT (c' t) part B)).testBit (b' t) = true := by
    apply bmS_bit _ _ _ _ _ (fun sd hsd => (hssok sd hsd).symm)
    apply bmT_bit _ _ _ _ hBbit
    intro r hr
    rw [nperp_bit _ _ (gof_lt _ _) hb1, par_gof_xof _ _ _ hb1 hc1,
      (hpartok r hr).1.2.1 t t (hpartok r hr).2 (hpartok r hr).2]
    simp
  have hmem : (b' t, c' t) ∈ cs := by
    rw [hcs]
    have hB0 : Nat.beq B 0 = false := by
      cases e : Nat.beq B 0
      · rfl
      · rw [Nat.eq_of_beq_eq_true e, Nat.zero_testBit] at hBbit; exact absurd hBbit Bool.false_ne_true
    have hC0 : Nat.beq Cb 0 = false := by
      cases e : Nat.beq Cb 0
      · rfl
      · rw [Nat.eq_of_beq_eq_true e, Nat.zero_testBit] at hCbit; exact absurd hCbit Bool.false_ne_true
    cases cdir
    · rw [cond_false, hB0, cond_false]
      exact candsB7_mem sym part ss.2 Cb hCblt (b' t) (c' t) (bitsOf B) (bitsOf_mem B hBlt _ hBbit) hcm
    · rw [cond_true, hC0, cond_false, hB0, cond_false]
      exact candsC_mem part ss.2 B hBlt (c' t) (b' t) (bitsOf Cb) (bitsOf_mem Cb hCblt _ hCbit) hbm
  refine ⟨_, hmem, b', c', ⟨?_, hinv'.bc, ?_, ?_, fun h => absurd h (List.cons_ne_nil _ _), ?_⟩, hlg', rfl, hmove⟩
  · intro u hu
    rw [Nat.testBit_xor, Nat.one_shiftLeft, Nat.testBit_two_pow] at hu
    by_cases e : u = t
    · rw [e]; exact htn
    · have e' : ¬ (t = u) := fun x => e x.symm
      simp only [e', decide_false, Bool.xor_false] at hu
      exact hinv'.act u hu
  · intro e he
    rcases List.mem_cons.mp he with h | h
    · rw [h]; exact ⟨hb1, hc1⟩
    · exact hinv'.asg_lt e h
  · intro X hX hdom
    rw [resM_cons, hinv'.hd X hX hdom]
    exact sum_hitS_step T n ACT X t htn hact (fun s => vecMulVec (nv (b' s)) (nv (c' s)))
  · intro r hr
    obtain ⟨r0, hr0, h⟩ := mem_updRecs (aT T t) (b' t) (c' t) allr r hr
    obtain ⟨u1, u2⟩ := updRec_ok hinv'.bc t htn hact r0 (hallok r0 hr0)
    rcases h with ⟨hp, rfl⟩ | ⟨hp, rfl⟩
    · exact u1 hp
    · exact u2 hp

/-- one node of `BC7L.checkSL`, with the recursive call `ih` -/
noncomputable def nodeSL (lt : Asg → Nat → Bool) (ih : Nat → Nat → Nat → Nat → Asg → List Rec → Nat → Nat → Bool × Nat)
    (TERMS SS ACT need : Nat) (asg : Asg) (recs : List Rec) (dom S : Nat) : Bool × Nat :=
      cond (Nat.beq (rd 1 S) 0)
        (let X := rd 9 (sk 1 S)
         (bit dom X && over6 SS ACT asg X, sk 10 S))
        (cond (Nat.beq (rd 6 S) 63)
          (let len := rd 24 (sk 6 S)
           (Nat.beq ACT 0 && lt asg (rd len (sk 30 S)), sk len (sk 30 S)))
          (let S1 := sk 1 S
           let t := rd 5 S1
           let sym := Nat.beq (rd 1 (sk 5 S1)) 1
           let cdir := Nat.beq (rd 1 (sk 6 S1)) 1
           let ntr := rdList (rd 4 (sk 7 S1)) (sk 11 S1)
           let slr := rdList (rd 3 ntr.2) (sk 3 ntr.2)
           let nt := ntr.1
           let sl := slr.1
           let a := Nat.land (Nat.shiftRight TERMS (Nat.mul 9 t)) 511
           let nr := mkRecs6 SS ACT asg nt []
           let part := thru a recs (thru a nr.2 [])
           let allr := app recs nr.2
           let ss := mkSls6 SS ACT asg sl
           let lgm := lgMask need t
           let B := andLm part (Nat.land (Nat.land ALLNZ lgm) (cond sym ORBM M512))
           let Cb := andRm part (Nat.land ALLNZ lgm)
           let cs : List (Nat × Nat) := cond cdir
             (cond (Nat.beq Cb 0) [] (cond (Nat.beq B 0) [] (candsC part ss.2 B (bitsOf Cb))))
             (cond (Nat.beq B 0) [] (candsB7 sym part ss.2 Cb (bitsOf B)))
           let ACT' := Nat.xor ACT (Nat.shiftLeft 1 t)
           let kr := @List.rec (Nat × Nat) (fun _ => Nat → Bool × Nat) (fun S => (true, S))
             (fun p _ ihc S => let r := ih TERMS SS ACT' need ((a, p.1, p.2) :: asg) (updRecs a p.1 p.2 allr) dom S
                cond r.1 (ihc r.2) (false, r.2)) cs slr.2
           (bit ACT t && ((!sym) || asg.isEmpty) && allDom dom nt && nr.1 && allDom dom sl && allThru a sl && ss.1 && kr.1,
            kr.2)))

theorem checkSL_succ (lt : Asg → Nat → Bool) (fuel TERMS SS ACT need : Nat) (asg : Asg) (recs : List Rec) (dom S : Nat) :
    BC7L.checkSL lt (fuel + 1) TERMS SS ACT need asg recs dom S =
      nodeSL lt (BC7L.checkSL lt fuel) TERMS SS ACT need asg recs dom S := rfl

/-- **Soundness of the node walk with SAT leaves.** If the leaf test never lets both `Y1` and `Y2` lift, no decomposition
whose path state is `(ACT, asg, recs)` lifts in both. -/
theorem checkSL_sound (lt : Asg → Nat → Bool) (Y1 Y2 : Nat)
    (hlt : ∀ asg w, lt asg w = true → ¬ (LiftL asg Y1 ∧ LiftL asg Y2)) (T n dom need : Nat) (hn : n ≤ 31) :
    ∀ fuel ACT asg recs S, (BC7L.checkSL lt fuel T (mkSSP T n) ACT need asg recs dom S).1 = true →
      ∀ b c, Inv T n dom b c ACT asg recs → AsgOK T n b c ACT asg → LGok n need b c →
        L479.Lift n b c Y1 → L479.Lift n b c Y2 → False := by
  intro fuel
  induction fuel with
  | zero => intro ACT asg recs S h; exact absurd h Bool.false_ne_true
  | succ fuel ih =>
    intro ACT asg recs S hchk b c hinv hasg hlg hl1 hl2
    rw [checkSL_succ] at hchk
    unfold nodeSL at hchk
    revert hchk
    cases hb : Nat.beq (rd 1 S) 0
    · rw [cond_false]
      cases ht31 : Nat.beq (rd 6 S) 63
      · rw [cond_false]
        show let S1 := sk 1 S
          let t := rd 5 S1
          let sym := Nat.beq (rd 1 (sk 5 S1)) 1
          let cdir := Nat.beq (rd 1 (sk 6 S1)) 1
          let ntr := rdList (rd 4 (sk 7 S1)) (sk 11 S1)
          let slr := rdList (rd 3 ntr.2) (sk 3 ntr.2)
          let nt := ntr.1
          let sl := slr.1
          let a := Nat.land (Nat.shiftRight T (Nat.mul 9 t)) 511
          let nr := mkRecs6 (mkSSP T n) ACT asg nt []
          let part := thru a recs (thru a nr.2 [])
          let allr := app recs nr.2
          let ss := mkSls6 (mkSSP T n) ACT asg sl
          let lgm := lgMask need t
          let B := andLm part (Nat.land (Nat.land ALLNZ lgm) (cond sym ORBM M512))
          let Cb := andRm part (Nat.land ALLNZ lgm)
          let cs : List (Nat × Nat) := cond cdir
            (cond (Nat.beq Cb 0) [] (cond (Nat.beq B 0) [] (candsC part ss.2 B (bitsOf Cb))))
            (cond (Nat.beq B 0) [] (candsB7 sym part ss.2 Cb (bitsOf B)))
          let ACT' := Nat.xor ACT (Nat.shiftLeft 1 t)
          let kr := @List.rec (Nat × Nat) (fun _ => Nat → Bool × Nat) (fun S => (true, S))
            (fun p _ ihc S => let r := BC7L.checkSL lt fuel T (mkSSP T n) ACT' need ((a, p.1, p.2) :: asg) (updRecs a p.1 p.2 allr) dom S
               cond r.1 (ihc r.2) (false, r.2)) cs slr.2
          (bit ACT t && ((!sym) || asg.isEmpty) && allDom dom nt && nr.1 && allDom dom sl && allThru a sl && ss.1 &&
            kr.1) = true → False
        intro S1 t sym cdir ntr slr nt sl a nr part allr ss lgm B Cb cs ACT' kr hchk
        have ha : a = aT T t := rfl
        have hcs : cs = brCands7 (mkSSP T n) ACT need asg recs t a nt sl sym cdir := rfl
        have hallr : allr = brAllr7 (mkSSP T n) ACT asg recs nt := rfl
        have hnr : nr = mkRecs6 (mkSSP T n) ACT asg nt [] := rfl
        have hss : ss = mkSls6 (mkSSP T n) ACT asg sl := rfl
        have hACT' : ACT' = ACT ^^^ 1 <<< t := rfl
        have hkr : kr = @List.rec (Nat × Nat) (fun _ => Nat → Bool × Nat) (fun S => (true, S))
            (fun p _ ihc S => let r := BC7L.checkSL lt fuel T (mkSSP T n) ACT' need ((a, p.1, p.2) :: asg) (updRecs a p.1 p.2 allr) dom S
               cond r.1 (ihc r.2) (false, r.2)) cs slr.2 := rfl
        have hnt : ∀ x ∈ nt, x < 512 := rdList_lt _ _
        have hsl : ∀ x ∈ sl, x < 512 := rdList_lt _ _
        clear_value S1 t sym cdir ntr slr nt sl a nr part allr ss lgm B Cb cs ACT' kr
        subst ha hcs hallr hnr hss hACT' hkr
        simp only [Bool.and_eq_true] at hchk
        obtain ⟨⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩, h8⟩ := hchk
        have hact : ACT.testBit t = true := by rw [← bit_eq]; exact h1
        have htn : t < n := hinv.act t hact
        obtain ⟨p, hp, b', c', hinv', hlg', hpe, hmove⟩ := br_step7_ex T n dom need (by omega) (mkSSP T n)
          (mkSSP_ok T n (by omega)) ACT asg recs t sym cdir nt sl hnt hsl h1 h2 h3 h4 h5 h6 h7 b c hinv hlg
        obtain ⟨S', hS'⟩ := kids_ok (fun p S => BC7L.checkSL lt fuel T (mkSSP T n) (ACT ^^^ 1 <<< t) need
          ((aT T t, p.1, p.2) :: asg) (updRecs (aT T t) p.1 p.2 (brAllr7 (mkSSP T n) ACT asg recs nt)) dom S) _ slr.2 h8 p hp
        have hasg' : AsgOK T n b' c' (ACT ^^^ 1 <<< t) ((aT T t, p.1, p.2) :: asg) := by
          rw [hpe]; exact asgOK_step (asgOK_move hasg hmove) t htn hact
        exact ih _ _ _ S' hS' b' c' hinv' hasg' hlg' (lift_of_move hmove hl1) (lift_of_move hmove hl2)
      · rw [cond_true]
        intro hchk
        have hchk' : (Nat.beq ACT 0 && lt asg (rd (rd 24 (sk 6 S)) (sk 30 S))) = true := hchk
        rw [Bool.and_eq_true] at hchk'
        obtain ⟨hA, hw⟩ := hchk'
        have hA' : ACT = 0 := Nat.eq_of_beq_eq_true hA
        subst hA'
        exact hlt asg _ hw ⟨liftL_of_complete hasg Y1 hl1, liftL_of_complete hasg Y2 hl2⟩
    · rw [cond_true]
      intro hchk
      exact over_step7 T n dom (by omega) (mkSSP T n) (mkSSP_ok T n (by omega)) ACT asg recs _
        (lt_of_lt_of_eq (rd_lt 9 _) (by norm_num)) hchk b c hinv

theorem leafSL_eq (lt : Asg → Nat → Bool) (R : Nat) : BC7L.leafSL lt R =
    (Nat.ble (rd 6 R) 31 &&
      ((Nat.beq (rd 1 (sk 1 (sk (Nat.add 6 (Nat.mul 9 (rd 6 R))) R))) 1 &&
          Nat.beq (rd 1 (sk (Nat.add 6 (Nat.mul 9 (rd 6 R))) R)) 0) && Nat.blt (rkSum (leafT R) (leafN R)) 27 ||
       (BC7L.checkSL lt 64 (leafT R) (mkSSP (leafT R) (leafN R)) (Nat.pred (Nat.shiftLeft 1 (leafN R)))
          (cond (Nat.beq (rd 1 (sk 1 (sk (Nat.add 6 (Nat.mul 9 (rd 6 R))) R))) 1 &&
              Nat.beq (rd 1 (sk (Nat.add 6 (Nat.mul 9 (rd 6 R))) R)) 0)
            (needP (leafT R) (leafN R) (Nat.sub (rkSum (leafT R) (leafN R)) 27)) 0) [] [] (leafDom6 R)
          (cond (Nat.beq (rd 1 (sk (Nat.add 6 (Nat.mul 9 (rd 6 R))) R)) 0)
            (sk 2 (sk (Nat.add 6 (Nat.mul 9 (rd 6 R))) R)) (sk 514 (sk (Nat.add 6 (Nat.mul 9 (rd 6 R))) R)))).1)) := rfl

/-- **Leaf theorem for one pair of classes.** -/
theorem leafSL_pair (lt : Asg → Nat → Bool) (Y1 Y2 : Nat)
    (hlt : ∀ asg w, lt asg w = true → ¬ (LiftL asg Y1 ∧ LiftL asg Y2)) (R : Nat) (h : BC7L.leafSL lt R = true) :
    L479.NoLift (leafT R) (leafN R) (leafDom6 R) Y1 Y2 := by
  intro b c hbc hd hl
  rw [leafSL_eq] at h
  set R1 := sk (Nat.add 6 (Nat.mul 9 (rd 6 R))) R with hR1
  set dm := Nat.beq (rd 1 R1) 0 with hdm
  set lg := Nat.beq (rd 1 (sk 1 R1)) 1 && dm with hlg
  set RS := rkSum (leafT R) (leafN R) with hRS
  have epred : Nat.pred (Nat.shiftLeft 1 (leafN R)) = 2 ^ leafN R - 1 := by
    show 1 <<< leafN R - 1 = _; rw [Nat.one_shiftLeft]
  rw [epred] at h
  rw [Bool.and_eq_true, Nat.ble_eq, Bool.or_eq_true] at h
  obtain ⟨hn, h⟩ := h
  have hfull : lg = true → leafDom6 R = ALLNZ := by
    intro hl
    have hd' : dm = true := by rw [hlg, Bool.and_eq_true] at hl; exact hl.2
    show cond dm ALLNZ _ = ALLNZ
    rw [hd', cond_true]
  have hdfull : lg = true → ∀ X, X < 512 → ALLNZ.testBit X = true →
      TX (toM3 X) = ∑ t ∈ (Finset.range (leafN R)).filter (fun t => par (aT (leafT R) t &&& X) = true),
        vecMulVec (nv (b t)) (nv (c t)) := by
    intro hl X hX hX'
    exact hd X hX (by rw [hfull hl]; exact hX')
  rcases h with h | h
  · rw [Bool.and_eq_true, Nat.blt_eq] at h
    obtain ⟨hl', hlt'⟩ := h
    have := (lg_root (leafT R) (leafN R) b c hbc (hdfull hl')).1
    omega
  · have hlgok : LGok (leafN R) (cond lg (needP (leafT R) (leafN R) (Nat.sub RS 27)) 0) b c := by
      cases hl' : lg
      · rw [cond_false]; exact lgok_zero _ b c hbc
      · rw [cond_true]
        exact (lg_root (leafT R) (leafN R) b c hbc (hdfull hl')).2
    exact checkSL_sound lt Y1 Y2 hlt (leafT R) (leafN R) (leafDom6 R) _ hn 64 _ [] [] _ h b c
      (S5.inv_root _ _ _ b c hbc hd) (asgOK_root _ _ b c) hlgok hl.1 hl.2

/-- **Leaf theorem (SAT leaves).** An accepted record with a sound leaf test refutes every lift in two classes. -/
theorem leafSL_sound (lt : Asg → Nat → Bool) (hlt : LiftTest lt) (R : Nat) (h : BC7L.leafSL lt R = true) :
    L479.NoLift3 (leafT R) (leafN R) (leafDom6 R) :=
  ⟨leafSL_pair lt _ _ (fun asg w hw => (hlt asg w hw).1) R h,
   leafSL_pair lt _ _ (fun asg w hw => (hlt asg w hw).2.1) R h,
   leafSL_pair lt _ _ (fun asg w hw => (hlt asg w hw).2.2) R h⟩

end S7L

