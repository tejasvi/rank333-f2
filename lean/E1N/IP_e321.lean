/-! # E1N.IP_e321: the native checker of the items of leaf2's E1 IP `e321` (W = 640-bit item keys: the class's single stream
is split at delegated literals; core only; not linked).  Generated by py/mkipmod1.py. -/
@[expose] public section
namespace E1N.IP_e321

/-- leaf2's group element `g` (`E1.gpE`: 896-bit fields of one Nat) -/
def gpE (GP g : Nat) : Nat := Nat.land (Nat.shiftRight GP (Nat.mul 896 g)) (Nat.sub (Nat.shiftLeft 1 896) 1)

/-- the IP's native data -/
def D : IPD :=
  mkIPD 7 15 4 4 R22D.E1.IP_e321.R R22D.E1.IP_e321.N R22D.E1.IP_e321.UB (half R22D.E1.SL_e321.chunk)
    (gpE R22D.E1.IP_e321.GP) (leafHookG R22D.E1.IP_e321.VT R22D.E1.IP_e321.DOM R22D.E1.IP_e321.EXT)

/-- the items of a chunk (640-bit keys) -/
def batch (ks : List Nat) (ss : List String) : Bool := batchLW D 640 ks ss

theorem batch_sound (ks : List Nat) (ss : List String) (h : batch ks ss = true) : R22N.KeysOK (CheckedW D 640) ks :=
  batchLW_sound D 640 ks ss h

end E1N.IP_e321
