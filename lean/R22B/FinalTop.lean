  R22B.Cor.table_23 rank_ge_23

/-- Rudich-Rousseau's crown at 23: no program that works on blocks multiplies 3x3 matrices with fewer than 23 multiplications -/
theorem recursive_23 : RecursiveAlgorithmMultiplicationsAtLeast 23 :=
  R22B.Cor.recursive_23 rank_ge_23

